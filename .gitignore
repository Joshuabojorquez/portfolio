.DS_Store
.claude-flow/

# ---- assets: allow-list, not deny-list ----
# GitHub hard-rejects any file over 100MB and Pages serves the whole repo, so
# only the compressed clips the site actually references are tracked. The raw
# camera/render sources stay on disk, they are just never committed. Adding a
# new clip means compressing it into /assets and adding one line here.
assets/*
!assets/hero-wide.mp4
!assets/hero-tall.mp4
!assets/ad-from7.mp4
!assets/nexus.mp4
!assets/ethos-hypershot.mp4
!assets/ahc.mp4
!assets/portfolio-reel.mp4
!assets/ethos-ad.mp4
!assets/solar.mp4
!assets/Joshua-Bojorquez-Resume.pdf
